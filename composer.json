{
    "name": "modx-extras/yandexmapslocator-dev",
    "description": "Development environment for YandexMapsLocator MODX 3 extra",
    "require": {
        "php": ">=8.2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "YandexMapsLocator\\": "core/components/yandexmapslocator/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YandexMapsLocator\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.99"
        }
    },
    "scripts": {
        "test": "pest",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-fix": "php-cs-fixer fix --dry-run --diff",
        "cs-fix-apply": "php-cs-fixer fix"
    }
}
